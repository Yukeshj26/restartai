# =============================================================================
# RestartAI Environment Configuration Template
# =============================================================================

# Server Settings
APP_HOST=127.0.0.1
APP_PORT=8000

# Call-E Telephony API Integration
CALLE_API_KEY=
CALL_E_MODE=demo
CALLE_BASE_URL=https://api.heycall-e.com

# Persistence Engine
# Default: SQLite stored locally at data/restartai.db
# PostgreSQL (Neon, Supabase, self-hosted):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Recovery Run Assistant LLM Settings
# Primary Provider: gemini | groq | anthropic | grok
LLM_PROVIDER=gemini

# Google Gemini (Recommended primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (Fast automated fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Alternative Providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GROK_API_KEY=
GROK_MODEL=grok-4.1-fast
